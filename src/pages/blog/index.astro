---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getCollection } from 'astro:content';
import { site } from '../../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const byYear = posts.reduce<Record<string, typeof posts>>((acc, p) => {
  const y = String(p.data.pubDate.getFullYear());
  (acc[y] ||= []).push(p);
  return acc;
}, {});
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
---
<Base title="Writing" description={`Notes by ${site.name} on building AI products: LLM evaluation, guardrails, agent tooling, and 0→1 product work.`}>
  <section class="page-head">
    <div class="wrap">
      <span class="label">Writing</span>
      <h1 class="page-title">Notes on building AI products.</h1>
      <p class="lead">Longer-form thinking on evaluation, guardrails, agent tooling, and what it actually takes to ship LLM features that hold up in production.</p>

    </div>
  </section>
  <section class="section">
    <div class="wrap narrow">
      <div>
        {posts.length > 0 ? (
          years.map((y) => (
            <section class="year">
              <span class="label">{y}</span>
              <div>{byYear[y].map((entry) => <PostRow entry={entry} />)}</div>
            </section>
          ))
        ) : (
          <div class="empty">
            <span class="label">First post in draft</span>
            <p>Nothing published yet. I'm working on the first piece. Until it lands, I share shorter notes on LinkedIn.</p>
            <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener">Follow on LinkedIn ↗</a>
          </div>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 860px; }
  .year { margin-bottom: 40px; }
  .year > .mono { display: block; margin-bottom: 8px; }
</style>
