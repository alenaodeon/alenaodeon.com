---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'projects'> };
const { Content } = await render(entry);
const { title, description, date, status, tags, link, repo } = entry.data;
const fmt = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' });
---
<Base title={title} description={description} type="article" publishedTime={date}>
  <article class="section">
    <div class="wrap narrow">
      <a class="link small" href="/projects">← All projects</a>
      <div class="meta">
        <span class="label">{fmt.format(date)}</span>
        <span class="label" style="color:var(--accent-ink)">{status}</span>
      </div>
      <h1 class="display">{title}</h1>
      <p class="lead" style="margin-top:16px">{description}</p>
      {(link || repo) && (
        <div class="actions">
          {link && <a class="btn" href={link} target="_blank" rel="noopener">Open project ↗</a>}
          {repo && <a class="btn btn-ghost" href={repo} target="_blank" rel="noopener">Source ↗</a>}
        </div>
      )}
      {tags.length > 0 && <div class="tags" style="margin-top:20px">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
      <div class="prose" style="margin-top:40px"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .narrow { max-width: 760px; }
  .meta { display: flex; gap: 16px; margin: 28px 0 14px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
</style>
