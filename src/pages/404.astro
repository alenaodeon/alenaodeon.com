---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" noindex>
  <section class="section">
    <div class="wrap" style="text-align:center; padding-top: 40px; padding-bottom: 40px">
      <span class="label">Error 404</span>
      <h1 class="display" style="margin-top:12px">Page not found.</h1>
      <p class="lead" style="margin: 18px auto 0">The link may be outdated. Try one of these instead.</p>
      <div style="margin-top:28px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap">
        <a class="btn" href="/">Home</a>
        <a class="btn btn-ghost" href="/experience">Experience</a>
      </div>
    </div>
  </section>
</Base>
