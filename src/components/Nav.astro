---
import { site, nav } from '../config';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="nav">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>{site.name}</a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} class:list={{ active: isActive(item.href) }}>{item.label}</a></li>
        ))}
        <li class="cta"><a class="btn btn-ghost" href={`mailto:${site.email}`}>Get in touch</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 50; background: rgba(250, 247, 242, 0.82); backdrop-filter: saturate(160%) blur(12px); -webkit-backdrop-filter: saturate(160%) blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 66px; }
  .brand { font-weight: 650; letter-spacing: -0.01em; white-space: nowrap; }
  nav ul { display: flex; align-items: center; gap: 4px; }
  nav a:not(.btn) { padding: 8px 12px; border-radius: 999px; font-size: 15px; color: var(--ink-2); font-weight: 500; transition: background 0.15s, color 0.15s; }
  nav a:not(.btn):hover, nav a.active { color: var(--ink); background: var(--bg-2); }
  .cta { margin-left: 8px; }
  .cta .btn { padding: 9px 15px; font-size: 14px; }
  @media (max-width: 640px) { .cta { display: none; } nav a:not(.btn) { padding: 8px 9px; font-size: 14px; } .brand { font-size: 15px; } }
</style>
