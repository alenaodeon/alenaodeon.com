---
import { site } from '../config';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="top">
      <div>
        <p class="mono eyebrow">Contact</p>
        <h2 class="h2">Building something with AI?<br />Let's talk.</h2>
        <p class="lead" style="margin-top:14px">The fastest way to reach me is email.</p>
        <div class="actions">
          <a class="btn" href={`mailto:${site.email}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            {site.email}
          </a>
          <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener me">LinkedIn ↗</a>
          <a class="btn btn-ghost" href={site.cv} download>Download CV</a>
        </div>
      </div>
    </div>
    <div class="bottom">
      <span class="small muted">© {year} {site.name}</span>
      <span class="small muted">alenaodeon.com</span>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); background: var(--bg-2); padding: clamp(56px, 8vw, 96px) 0 32px; }
  .top { max-width: 720px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--line-2); }
  .mono-inline { font-family: var(--mono); font-size: 12.5px; text-transform: none; }
</style>
