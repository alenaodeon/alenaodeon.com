---
import { site } from '../config';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="top">
      <div>
        <span class="label">Contact</span>
        <h2 class="h2">Building something with AI?<br />Let's talk.</h2>
        <p class="lead">The fastest way to reach me is email.</p>
        <div class="actions">
          <a class="btn" href={`mailto:${site.email}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            {site.email}
          </a>
          <a class="btn btn-dark" href={site.linkedin} target="_blank" rel="noopener me">LinkedIn ↗</a>
          <a class="btn btn-dark" href={site.cv} download>Download CV</a>
        </div>
      </div>
      <dl class="facts">
        <div><dt class="label">Based in</dt><dd>{site.location}</dd></div>
        <div><dt class="label">Currently</dt><dd>{site.now}</dd></div>
      </dl>
    </div>
    <div class="bottom">
      <span class="small">© {year} {site.name}</span>
      <span class="small">alenaodeon.com</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--dark); color: var(--on-dark); padding: clamp(56px, 8vw, 96px) 0 32px; }
  .footer .label { color: var(--on-dark-muted); margin-bottom: 14px; }
  .footer .h2 { color: #fff; }
  .footer .lead { color: var(--on-dark-muted); margin-top: 14px; }
  .top { display: grid; gap: 40px; }
  @media (min-width: 860px) { .top { grid-template-columns: 1.4fr 1fr; align-items: start; } }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .btn-dark { background: var(--dark-2); color: #fff; border-color: #2a3142; }
  .btn-dark:hover { background: #1c2230; border-color: #3a4256; box-shadow: none; }
  .facts { margin: 0; display: grid; gap: 18px; padding-top: 6px; }
  .facts div { border-top: 1px solid #262c3a; padding-top: 14px; }
  .facts dt { margin-bottom: 4px; }
  .facts dd { margin: 0; font-weight: 600; color: #fff; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin-top: 56px; padding-top: 20px; border-top: 1px solid #262c3a; color: var(--on-dark-muted); }
</style>
